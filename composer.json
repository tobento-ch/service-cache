{
    "name": "tobento/service-cache",
    "version": "2.0",
    "type": "library",
    "description": "Providing PSR-6 and PSR-16 caches for PHP applications.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "cache",
        "PSR-6",
        "PSR-16"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/service-clock": "^2.0",
        "tobento/service-iterable": "^2.0",
        "psr/clock": "^1.0",
        "psr/cache": "^3.0",
        "psr/simple-cache": "^3.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-file-storage": "^2.0",
        "tobento/service-storage": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Cache\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Cache\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}